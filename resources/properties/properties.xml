<resources>
    <properties>
        <!-- 0 = GPS Nearest, 1 = Fav 1, 2 = Fav 2, 3 = Fav 3, 4 = Pinned Watch Stop -->
        <property id="activeStopMode" type="number">1</property>

        <!-- Users can enter either a Stop Name (e.g. "Jernbanetorget") or an NSR:StopPlace:ID -->
        <property id="stopQuery1" type="string">Jernbanetorget</property>
        <property id="stopQuery2" type="string">Majorstuen</property>
        <property id="stopQuery3" type="string">Nationaltheatret</property>

        <!-- Sort by transport mode first, then departure time -->
        <property id="sortByModeFirst" type="boolean">true</property>

        <!-- Required Entur ET-Client-Name header -->
        <property id="clientName" type="string">personal-garmin-avgang-widget</property>
    </properties>

    <settings>
        <setting propertyKey="@Properties.activeStopMode" title="@Strings.ActiveStopModeTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.ModeGps</listEntry>
                <listEntry value="1">@Strings.ModeFav1</listEntry>
                <listEntry value="2">@Strings.ModeFav2</listEntry>
                <listEntry value="3">@Strings.ModeFav3</listEntry>
                <listEntry value="4">@Strings.ModePinned</listEntry>
            </settingConfig>
        </setting>

        <setting propertyKey="@Properties.stopQuery1" title="@Strings.StopQuery1Title">
            <settingConfig type="alphaNumeric" />
        </setting>
        <setting propertyKey="@Properties.stopQuery2" title="@Strings.StopQuery2Title">
            <settingConfig type="alphaNumeric" />
        </setting>
        <setting propertyKey="@Properties.stopQuery3" title="@Strings.StopQuery3Title">
            <settingConfig type="alphaNumeric" />
        </setting>

        <setting propertyKey="@Properties.sortByModeFirst" title="@Strings.SortByModeTitle">
            <settingConfig type="boolean" />
        </setting>

        <setting propertyKey="@Properties.clientName" title="@Strings.ClientNameTitle">
            <settingConfig type="alphaNumeric" />
        </setting>
    </settings>
</resources>
