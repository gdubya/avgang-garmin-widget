<resources>
    <properties>
        <!-- 0 = GPS Nearest, 1 = Fav 1, 2 = Fav 2, 3 = Fav 3, 4 = Pinned Watch Stop -->
        <property id="activeStopMode" type="number">1</property>

        <!-- Users can enter either a Stop Name (e.g. "Jernbanetorget") or an NSR:StopPlace:ID -->
        <property id="stopQuery1" type="string">Jernbanetorget</property>
        <property id="stopQuery2" type="string">Majorstuen</property>
        <property id="stopQuery3" type="string">Nationaltheatret</property>

        <!-- Optional per-favourite filters. Empty = no filter (same behaviour as before) -->
        <!-- Transport modes: comma-separated Entur modes (e.g. "bus, tram"). Empty = all modes -->
        <property id="stopModes1" type="string"></property>
        <property id="stopModes2" type="string"></property>
        <property id="stopModes3" type="string"></property>
        <!-- Lines: comma-separated public line codes (e.g. "21"). Replaces the global favourite lines for that stop -->
        <property id="stopLines1" type="string"></property>
        <property id="stopLines2" type="string"></property>
        <property id="stopLines3" type="string"></property>

        <!-- Sort by transport mode first, then departure time -->
        <property id="sortByModeFirst" type="boolean">true</property>

        <!-- Glance: show the next departure for each of the first two directions (line + destination) -->
        <property id="glanceShowDirections" type="boolean">false</property>

        <!-- Favourite lines: comma-separated public line codes (e.g. "17, 31"). Empty = show all lines -->
        <property id="routeFilter" type="string"></property>
        <!-- Apply the favourite line filter (can also be toggled on the watch) -->
        <property id="routeFilterEnabled" type="boolean">true</property>

        <!-- Required Entur ET-Client-Name header -->
        <property id="clientName" type="string">personal-garmin-avgang-widget</property>
    </properties>

    <settings>
        <setting propertyKey="@Properties.activeStopMode" title="@Strings.ActiveStopModeTitle">
            <settingConfig type="list">
                <listEntry value="0">@Strings.ModeGps</listEntry>
                <listEntry value="1">@Strings.ModeFav1</listEntry>
                <listEntry value="2">@Strings.ModeFav2</listEntry>
                <listEntry value="3">@Strings.ModeFav3</listEntry>
                <listEntry value="4">@Strings.ModePinned</listEntry>
            </settingConfig>
        </setting>

        <setting propertyKey="@Properties.stopQuery1" title="@Strings.StopQuery1Title">
            <settingConfig type="alphaNumeric" />
        </setting>
        <setting propertyKey="@Properties.stopModes1" title="@Strings.StopModes1Title">
            <settingConfig type="alphaNumeric" />
        </setting>
        <setting propertyKey="@Properties.stopLines1" title="@Strings.StopLines1Title">
            <settingConfig type="alphaNumeric" />
        </setting>
        <setting propertyKey="@Properties.stopQuery2" title="@Strings.StopQuery2Title">
            <settingConfig type="alphaNumeric" />
        </setting>
        <setting propertyKey="@Properties.stopModes2" title="@Strings.StopModes2Title">
            <settingConfig type="alphaNumeric" />
        </setting>
        <setting propertyKey="@Properties.stopLines2" title="@Strings.StopLines2Title">
            <settingConfig type="alphaNumeric" />
        </setting>
        <setting propertyKey="@Properties.stopQuery3" title="@Strings.StopQuery3Title">
            <settingConfig type="alphaNumeric" />
        </setting>
        <setting propertyKey="@Properties.stopModes3" title="@Strings.StopModes3Title">
            <settingConfig type="alphaNumeric" />
        </setting>
        <setting propertyKey="@Properties.stopLines3" title="@Strings.StopLines3Title">
            <settingConfig type="alphaNumeric" />
        </setting>

        <setting propertyKey="@Properties.routeFilter" title="@Strings.RouteFilterTitle">
            <settingConfig type="alphaNumeric" />
        </setting>
        <setting propertyKey="@Properties.routeFilterEnabled" title="@Strings.RouteFilterEnabledTitle">
            <settingConfig type="boolean" />
        </setting>

        <setting propertyKey="@Properties.sortByModeFirst" title="@Strings.SortByModeTitle">
            <settingConfig type="boolean" />
        </setting>

        <setting propertyKey="@Properties.glanceShowDirections" title="@Strings.GlanceShowDirectionsTitle">
            <settingConfig type="boolean" />
        </setting>

        <setting propertyKey="@Properties.clientName" title="@Strings.ClientNameTitle">
            <settingConfig type="alphaNumeric" />
        </setting>
    </settings>
</resources>
