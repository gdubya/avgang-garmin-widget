<resources>
    <properties>
        <!-- Default to Jernbanetorget (NSR:StopPlace:4000) as a sample Ruter stop -->
        <property id="stopPlaceId" type="string">NSR:StopPlace:4000</property>
        <property id="useGpsNearest" type="boolean">false</property>
        <property id="clientName" type="string">personal-garmin-ruter-widget</property>
    </properties>

    <settings>
        <setting propertyKey="@Properties.stopPlaceId" title="@Strings.StopIdTitle">
            <settingConfig type="alphaNumeric" />
        </setting>
        <setting propertyKey="@Properties.useGpsNearest" title="@Strings.UseGpsTitle">
            <settingConfig type="boolean" />
        </setting>
        <setting propertyKey="@Properties.clientName" title="@Strings.ClientNameTitle">
            <settingConfig type="alphaNumeric" />
        </setting>
    </settings>
</resources>
